NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Message notifications: server-only; use a sender verified in Resend.
RESEND_API_KEY=
MESSAGE_EMAIL_FROM=
MESSAGE_EMAIL_SITE_URL=https://www.trovun.ca
# Only needed if using the optional Next.js cron endpoint instead of Supabase Cron.
CRON_SECRET=

# Optional AI assistance and private listing flags; never expose these to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# CRON_SECRET also secures /api/cron/listing-reviews (schedule every minute).
